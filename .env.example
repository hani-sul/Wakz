# TechPulse configuration — copy to .env and adjust. Never commit real secrets.

# HTTP API
TECHPULSE_API_HOST=127.0.0.1
TECHPULSE_API_PORT=4310
TECHPULSE_WEB_ORIGIN=http://localhost:4310

# Storage
TECHPULSE_DB_PATH=./data/techpulse.db

# Collector behaviour
TECHPULSE_COLLECTOR_CONCURRENCY=6
TECHPULSE_DEFAULT_POLL_SECONDS=60
TECHPULSE_CONNECTIVITY_POLL_SECONDS=30
TECHPULSE_COLLECTOR_REGION=local
TECHPULSE_ICMP_ENABLED=false
TECHPULSE_LOG_LEVEL=info

# Health engine thresholds
TECHPULSE_DEGRADED_AFTER_FAILURES=2
TECHPULSE_DOWN_AFTER_FAILURES=4
TECHPULSE_MAJOR_OUTAGE_LATENCY_MS=3000
TECHPULSE_DEGRADED_LATENCY_MS=1200
TECHPULSE_CHECK_TIMEOUT_MS=10000

# Admin API (developer tools). Leave empty to disable admin routes entirely.
TECHPULSE_ADMIN_TOKEN=

# Optional connector credentials (not required for the MVP)
RIOT_API_KEY=
