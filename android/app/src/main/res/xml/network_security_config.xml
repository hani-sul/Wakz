<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The dashboard can be pointed at a TechPulse server on the local network. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
